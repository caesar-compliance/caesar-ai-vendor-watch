# Database — PostgreSQL (Supabase)
# Local dev (session pooler, port 5432):
# DATABASE_URL="postgresql://postgres.[ref]:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"
# Vercel / serverless (transaction pooler, port 6543 — recommended for production):
DATABASE_URL="postgresql://postgres.[ref]:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# GitHub API — token from https://github.com/settings/tokens (user: artemhobotun)
GITHUB_TOKEN="ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# LLM API — https://openrouter.ai/keys or any OpenAI-compatible key
LLM_API_KEY="sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Cron security — generate with: openssl rand -base64 32
CRON_SECRET="your-random-secret-string-here"

# Public app URL (localhost for dev, your domain in production)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Production example: https://vendor-watch.caesar.no

# GitHub repo link (footer) — caesar-compliance org
NEXT_PUBLIC_GITHUB_REPO_URL="https://github.com/caesar-compliance/caesar-vendor-watch"

# Optional — external email digest subscribe page
# NEXT_PUBLIC_EMAIL_SUBSCRIBE_URL="https://example.com/subscribe"
